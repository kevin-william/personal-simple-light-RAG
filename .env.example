# ==============================================================================
# CONFIGURAÇÃO DE MODELOS E AMBIENTE - PERSONAL SIMPLE LIGHT RAG
# ==============================================================================

# Dispositivos de Execução
# - Para CPU: LLM_BACKEND=cpu, EMBEDDING_DEVICE=cpu, N_GPU_LAYERS=0
# - Para Misto: LLM_BACKEND=cuda, EMBEDDING_DEVICE=cpu, N_GPU_LAYERS=-1 (Recomendado com GPU de 6GB)
# - Para CUDA: LLM_BACKEND=cuda, EMBEDDING_DEVICE=cuda, N_GPU_LAYERS=-1
LLM_BACKEND=cpu
EMBEDDING_DEVICE=cpu
N_GPU_LAYERS=0

# Threads de inferência na CPU (None = detecção automática de núcleos físicos, evitando contenção de HyperThreading)
# LLM_THREADS=6

# Modo de residência dos modelos ('resident' mantém em memória; 'alternating' alterna se pouca RAM/VRAM)
MEMORY_MODE=resident

# Parâmetros de contexto e resposta da LLM
LLM_BATCH_SIZE=128
CONTEXT_SIZE=4096
MAX_RESPONSE_TOKENS=512

# Divisão documental e busca
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=150
TOP_K=4
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_TOKENS=512

# ==============================================================================
# CATÁLOGO DE SUGESTÕES DE MODELOS DE LLM
# ==============================================================================

# ------------------------------------------------------------------------------
# Opção 1 (Padrão Recomendado para CPU): Phi-4-mini Instruct Q4_K_M (~2,5 GB)
# Velocidade em CPU: ~8 a 9 tokens/s (Dobra a taxa em relação ao Q8 com fidelidade excelente)
# ------------------------------------------------------------------------------
MODEL_REPO_ID=unsloth/Phi-4-mini-instruct-GGUF
MODEL_FILENAME=Phi-4-mini-instruct-Q4_K_M.gguf
MODEL_REVISION=78eb92a46fc37e6b524df991ed9aca9bc6aa7b80

# ------------------------------------------------------------------------------
# Opção 2 (CPU Balanceado e Rápido): Qwen 2.5 3B Instruct Q4_K_M (~2,1 GB)
# Velocidade em CPU: ~10 tokens/s (Modelo compacto e muito competente em português)
# ------------------------------------------------------------------------------
# MODEL_REPO_ID=Qwen/Qwen2.5-3B-Instruct-GGUF
# MODEL_FILENAME=qwen2.5-3b-instruct-q4_k_m.gguf
# MODEL_REVISION=7dabda4d13d513e3e842b20f0d435c732f172cbe

# ------------------------------------------------------------------------------
# Opção 3 (CPU Ultra-Leve): Qwen 2.5 1.5B Instruct Q4_K_M (~1,1 GB)
# Velocidade em CPU: ~18 a 20 tokens/s (Ideal para máquinas com CPU mais antiga ou pouca RAM)
# ------------------------------------------------------------------------------
# MODEL_REPO_ID=Qwen/Qwen2.5-1.5B-Instruct-GGUF
# MODEL_FILENAME=qwen2.5-1.5b-instruct-q4_k_m.gguf
# MODEL_REVISION=91cad51170dc346986eccefdc2dd33a9da36ead9

# ------------------------------------------------------------------------------
# Opção 4 (GPU / VRAM >= 6GB): Phi-4-mini Instruct Q8_0 (~4,1 GB)
# Velocidade em GPU CUDA: ~35 tokens/s (Máxima fidelidade para execução com placa de vídeo)
# ------------------------------------------------------------------------------
# MODEL_REPO_ID=unsloth/Phi-4-mini-instruct-GGUF
# MODEL_FILENAME=Phi-4-mini-instruct.Q8_0.gguf
# MODEL_REVISION=78eb92a46fc37e6b524df991ed9aca9bc6aa7b80

# ==============================================================================
# CATÁLOGO DE SUGESTÕES DE MODELOS DE EMBEDDINGS
# ==============================================================================

# ------------------------------------------------------------------------------
# Opção A (Padrão Atual): BAAI/bge-m3 (~2,2 GB, 1024 dimensões)
# Excelente recuperação semântica multilíngue densa e profunda.
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DIMENSION=1024

# ------------------------------------------------------------------------------
# Opção B (Leve e Multilíngue para CPU): paraphrase-multilingual-MiniLM-L12-v2 (~470 MB, 384 dimensões)
# 5x menor em RAM que o BGE-M3, ideal para inicialização rápida em CPU.
# ATENÇÃO: Ao trocar o modelo de embeddings, a base do Chroma deve ser resetada (--reset)
# ou apontada para outra pasta de dados (--data-dir).
# ------------------------------------------------------------------------------
# EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_MODEL_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
# EMBEDDING_DIMENSION=384

# ------------------------------------------------------------------------------
# Opção C (Ultra-Leve): all-MiniLM-L6-v2 (~90 MB, 384 dimensões)
# Focado em inglês ou buscas simples, footprint quase nulo em RAM.
# ------------------------------------------------------------------------------
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_MODEL_REVISION=fa97f14032d84c6c96a3fc26330058e575b6ae04
# EMBEDDING_DIMENSION=384
