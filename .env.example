LLM_BACKEND=cuda
EMBEDDING_DEVICE=cuda
N_GPU_LAYERS=-1
MEMORY_MODE=resident
CONTEXT_SIZE=4096
MAX_RESPONSE_TOKENS=512
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=150
TOP_K=4
MEMORY_SUMMARY_MAX_TOKENS=192
QUERY_RESOLUTION_MAX_TOKENS=256
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_TOKENS=512
# Perfil CPU: use --profile cpu, que ajusta os três parâmetros de backend.
# Para pouca VRAM: MEMORY_MODE=alternating e ajuste N_GPU_LAYERS se necessário.
