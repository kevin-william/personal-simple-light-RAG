LLM_BACKEND=cuda
EMBEDDING_DEVICE=cpu
N_GPU_LAYERS=-1
LLM_BATCH_SIZE=128
MEMORY_MODE=resident
CONTEXT_SIZE=4096
MAX_RESPONSE_TOKENS=512
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=150
TOP_K=4
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_TOKENS=512
# Perfil CPU: use --profile cpu, que ajusta os três parâmetros de backend.
# Padrão misto: Phi na GPU e embeddings na CPU, ambos residentes.
# --profile cuda seleciona explicitamente ambos na GPU (modo legado).
